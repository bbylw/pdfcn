---
const year = new Date().getFullYear();
const cols = [
  {
    title: "文档",
    links: [
      { label: "介绍", href: "/docs" },
      { label: "安装", href: "/docs/installation" },
      { label: "组件", href: "/docs/components" },
      { label: "区块", href: "/docs/blocks" },
    ],
  },
  {
    title: "社区",
    links: [
      { label: "GitHub", href: "https://github.com/shadcn-labs/pdfcn" },
      { label: "Issues", href: "https://github.com/shadcn-labs/pdfcn/issues" },
      { label: "Discussions", href: "https://github.com/shadcn-labs/pdfcn/discussions" },
      { label: "Discord", href: "https://discord.gg/N6G36KhYK4" },
    ],
  },
  {
    title: "项目",
    links: [
      { label: "贡献指南", href: "https://github.com/shadcn-labs/pdfcn/blob/main/CONTRIBUTING.md" },
      { label: "行为准则", href: "https://github.com/shadcn-labs/pdfcn/blob/main/CODE_OF_CONDUCT.md" },
      { label: "安全报告", href: "https://github.com/shadcn-labs/pdfcn/blob/main/SECURITY.md" },
      { label: "MIT 许可证", href: "https://github.com/shadcn-labs/pdfcn/blob/main/LICENSE" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer-inner">
      <div>
        <a class="brand" href="/" style="margin-bottom:12px">
          <span class="brand-mark" aria-hidden="true">p</span>
          <span>pdfcn</span>
        </a>
        <p style="color:var(--ink-soft);margin:12px 0 16px;max-width:30ch">
          免费开源、开箱即用、可定制的 React PDF 组件库。
        </p>
        <span class="cmyk-bar" role="presentation"><span></span><span></span><span></span><span></span></span>
      </div>
      {
        cols.map((col) => (
          <nav aria-label={col.title}>
            <h4>{col.title}</h4>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href} target={l.href.startsWith("http") ? "_blank" : undefined} rel={l.href.startsWith("http") ? "noopener noreferrer" : undefined}>
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <div class="footer-fine">
      <span>pdfcn 是 shadcn-labs 的开源项目，本站为中文非官方文档。</span>
      <span>MIT License · {year}</span>
    </div>
  </div>
</footer>
