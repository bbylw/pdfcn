---
const path = Astro.url.pathname;
const nav = [
  { label: "特性", href: "/#features" },
  { label: "引擎", href: "/#engines" },
  { label: "组件", href: "/#catalog" },
  { label: "文档", href: "/docs" },
];
---

<header class="site-header">
  <div class="wrap site-header-inner">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">p</span>
      <span>pdfcn</span>
    </a>
    <nav class="site-nav" aria-label="站点导航">
      {nav.map((item) => <a href={item.href} aria-current={item.href === "/docs" && path.startsWith("/docs") ? "true" : undefined}>{item.label}</a>)}
      <a class="nav-extra" href="https://github.com/shadcn-labs/pdfcn" target="_blank" rel="noopener noreferrer" aria-label="GitHub 仓库">
        <i class="ph ph-github-logo icon-inline" aria-hidden="true"></i>
      </a>
    </nav>
  </div>
</header>
